# --- required for the site to run -------------------------------------------
# The canonical origin. Every canonical tag, sitemap URL, robots.txt sitemap
# line, schema.org block and Open Graph tag is built from this one value, so a
# domain change is this variable and nothing else. Set it at BOTH build time and
# runtime. Unset, the site names itself by its old preview domain.
SITE_URL=https://businessidea.io

# Supabase. The server-only names are what production reads; the VITE_ names are
# the same values exposed to the browser for the auth client, and are baked into
# the bundle at BUILD time -- so they must be present when the build runs, not
# only at runtime.
IDEAVAULT_DB_URL=
IDEAVAULT_DB_ANON_KEY=
VITE_IDEAVAULT_DB_URL=
VITE_IDEAVAULT_DB_ANON_KEY=

# --- pipeline and outreach tooling, not needed to serve the site ------------
BLITZ_API_KEY=
BLITZ_BASE_URL=
COMPANY_CITY=
COMPANY_COUNTRY=
COMPANY_NAME=
COMPANY_STATE=
COMPANY_STREET=
COMPANY_ZIP=
DEFAULT_REPLY_TO_EMAIL=
DYNADOT_API_KEY=
INSTANTLY_API_KEY=
OPENROUTER_API_KEY=
PROSPEO_API_KEY=
RAPIDAPI_KEY=
SENDER_EMAIL_PREFIX_1=
SENDER_EMAIL_PREFIX_2=
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SMARTLEAD_API_KEY=
ZAPMAIL_API_KEY=
